# Zugang zum Sprachmodell. Der Dienst spricht die OpenAI-kompatible Chat-API,
# damit das Modell austauschbar bleibt. Datei nach ".env" kopieren und ausfüllen.

# --- Google Gemini (OpenAI-kompatibler Endpunkt) --------------------------
# Endpunkt und Modellnamen vor dem Einsatz in der Google-Dokumentation prüfen.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODELL=gemini-3.7-flash
LLM_API_KEY=



# --- Alternativen ----------------------------------------------------------
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1
# Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1
# Lokal:      LLM_BASE_URL=http://localhost:11434/v1

# Umfang des Katalogs.
#   vollstaendig  alle 2429 Aufgaben - auch die ohne unmittelbaren Bürgerbezug.
#                 408 davon sind als "nur verwaltungsintern" markiert und werden
#                 vom Regelwerk nur bei ausdrücklicher Frage genannt. Standard.
#   buerger       nur die 1618 Aufgaben mit erkennbarem Außenbezug. Spart Kontext,
#                 macht aber Gremien, Beiräte und Beauftragte unauffindbar.
#                 Nur nötig, wenn das Modell ein kleines Kontextfenster hat.
KATALOG_UMFANG=vollstaendig

# Detailtiefe des Katalogs. Umfang und Detailtiefe zusammen müssen ins
# Kontextfenster des Modells passen (Tokenzahlen: vollstaendig / buerger):
#   voll     415.000 / 276.000  alle Teilaufgaben
#   mittel   247.000 / 165.000  gekürzte Teilaufgaben
#   kompakt  158.000 / 107.000  nur Titel und Stelle
# Faustregel: Gemini 2M und Claude 1M vertragen jede Kombination. Für 200k-Modelle
# passt vollstaendig+kompakt, für 128k-Modelle nur buerger+kompakt.
KATALOG_PROFIL=voll

# --- Antwortcache ------------------------------------------------------------
# Gleiche Frage, gespeicherte Antwort, kein Modellaufruf. Liegt im
# Arbeitsspeicher der Instanz - auf Vercel hilft er innerhalb einer warmen
# Instanz, nicht über einen Kaltstart hinweg.
CACHE_TTL_STUNDEN=168         # 7 Tage
CACHE_MAX=2000                # Anzahl gespeicherter Antworten

# Kostenobergrenze: Es gibt bewusst keine Ratenbegrenzung im Code, weil die
# Zähler in einer Serverless-Umgebung ohnehin bei jedem Kaltstart bei null
# beginnen. Die harte Grenze gehört stattdessen in die Google-Konsole
# (API-Kontingent pro Tag plus Budgetwarnung). Ein Modellaufruf verbraucht rund
# 428.000 Eingabe-Token - ohne Kontingent kann ein Skript in einer Schleife sehr
# schnell sehr viel Geld ausgeben.
